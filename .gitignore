# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# leftover build artifacts from the old veritax-ui subfolder (app moved to root)
/veritax-ui/

# never commit backend env / secrets
backend/.env
.env

# python backend
.venv/
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# python build metadata
*.egg-info/

# local filesystem storage (LocalStorage)
_storage/

# raw company-research payloads — 23-30MB each; the standardizer (scripts/build-companies.mjs) extracts
# web-servable files into public/companies/ which ARE committed. Keep the raw drops out of the repo.
/apple-inc/
/microsoft-corp/

# SEC submissions cache used by scripts/build-universe.mjs (regenerable)
/.cache/

# Company data now lives in Supabase (pushed by scripts/push_to_supabase.py). The locally-built per-company
# JSON is just the push staging area — keep it out of git. Serve the compact search index statically so
# search does not download the whole table on every visit (that blew the Supabase egress cap).
/public/companies/*
!/public/companies/world.geo.json
!/public/companies/index.json

.vercel
