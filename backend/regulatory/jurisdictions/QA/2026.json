    {
      "source_id": "qa_gta_tp_faq",
      "title": "GTA Transfer Pricing Declaration / Master File / Local File FAQ and Dhareeba Submission Manual",
      "issuing_authority": "General Tax Authority (GTA)",
      "source_type": "guidance",
      "jurisdiction": "QA",
      "language": "en",
      "status": "active"
    }
  ],
  "rules": [
    {
      "rule_key": "local_file_required",
      "rule_category": "applicability",
      "rule_type": "documentation_applicability",
      "version": 1,
      "effective_from": "2020-01-01",
      "effective_to": null,
      "conditions": {
        "all": [
          { "field": "annual_turnover_or_assets", "operator": ">=", "value": 50000000, "currency": "QAR" },
          { "field": "has_foreign_associated_enterprise", "operator": "=", "value": true }
        ]
      },
      "result": true,
      "plain_english": "A Local File is required when annual turnover or total assets are at least QAR 50 million and the group includes a foreign associated enterprise.",
      "source_ids": ["qa_resolution_4_2020", "qa_income_tax_law_24_2018"],
      "verification_status": "verified"
    },
    {
      "rule_key": "master_file_required",
      "rule_category": "applicability",
      "rule_type": "documentation_applicability",
      "version": 1,
      "effective_from": "2020-01-01",
      "effective_to": null,
      "conditions": {
        "all": [
          { "field": "annual_turnover_or_assets", "operator": ">=", "value": 50000000, "currency": "QAR" },
          { "field": "has_foreign_associated_enterprise", "operator": "=", "value": true }
        ]
      },
      "result": true,
      "plain_english": "A Master File is required on the same QAR 50 million turnover-or-assets test where the group includes a foreign associated enterprise.",
      "source_ids": ["qa_resolution_4_2020"],
      "verification_status": "verified"
    },
    {
      "rule_key": "transaction_category_materiality",
      "rule_category": "materiality",
      "rule_type": "per_category_threshold",
      "version": 1,
      "effective_from": "2020-01-01",
      "effective_to": null,
      "conditions": {
        "all": [
          { "field": "category_annual_amount", "operator": ">=", "value": 200000, "currency": "QAR" }
        ]
      },
      "result": true,
      "plain_english": "A controlled-transaction category is in scope for the Local File when its annual amount is at least QAR 200,000. Amounts are taken per the taxpayer's accounts and must not be netted between income and expenses or between acquisitions and disposals.",
      "source_ids": ["qa_gta_tp_faq"],
      "verification_status": "verified"
    },
    {
      "rule_key": "local_file_filing_deadline",
      "rule_category": "filing",
      "rule_type": "documentation_deadline",
      "version": 1,
      "effective_from": "2020-01-01",
      "effective_to": null,
      "conditions": null,
      "result": { "due_month": 6, "due_day": 30, "year_offset": 1 },
      "plain_english": "The Master File and Local File are due no later than 30 June of the year following the relevant fiscal year (GTA Resolution No. 4 of 2020 and GTA FAQ). Treated as the primary rule where a source conflict with the older Dhareeba manual exists.",
      "source_ids": ["qa_resolution_4_2020"],
      "verification_status": "verified"
    }
  ]
}
