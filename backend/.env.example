# Postgres (you provide this; pgvector must be available)
# Prod: Supabase Connect → Session pooler (port 5432), then postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://veritax:veritax@localhost:5432/veritax

# Object storage (MinIO locally; Cloudflare R2 in prod)
# Prod: S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com  S3_REGION=auto
# Leave S3_ENDPOINT_URL blank to use local disk (dev only — Fly disk is wiped on restart).
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=veritax-sources
S3_REGION=us-east-1

# OCR fallback for scanned PDFs
OCR_ENABLED=true
OCR_COMMAND=ocrmypdf
OCR_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=600
OCR_MIN_TEXT_CHARS=200

# Embeddings (Voyage)
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-law-2
EMBEDDING_DIM=1024

# Requirement-coverage assessment + drafting (Anthropic)
ANTHROPIC_API_KEY=
ASSESSMENT_MODEL=claude-haiku-4-5
DRAFT_MODEL=claude-sonnet-4-6

# DeepSeek (OpenAI-compatible). If set, used for assessment + drafting instead of Anthropic.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# CORS (frontend origins, comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:3000,https://app.veritaxai.com

# Supabase Auth — JWKS + issuer. Same project URL as the frontend.
SUPABASE_URL=
# Only if the project still uses legacy HS256 (API 401 says so):
# SUPABASE_JWT_SECRET=
