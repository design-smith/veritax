# Frontend (Next.js) public environment variables. Copy to .env.local and fill in real values.
# NEXT_PUBLIC_* values are exposed to the browser — never put secrets/service-role keys here.

# Supabase (auth + app data)
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# FastAPI backend base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# PostHog analytics — DEDICATED demo project (project id 551932, US Cloud).
# NEXT_PUBLIC_POSTHOG_KEY is a write-only client token, safe to expose in public apps.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Analytics is OFF unless explicitly enabled (keep false in local dev).
NEXT_PUBLIC_POSTHOG_ENABLED=false
# When true (non-prod), analytics logs [event] + [properties] to the console instead of/in addition to sending.
NEXT_PUBLIC_ANALYTICS_DEBUG=false
